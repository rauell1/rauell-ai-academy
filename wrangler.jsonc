{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rauell-ai-academy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // See worker/undici-fetch.ts: undici cannot run on Workers.
  "alias": { "undici": "./worker/undici-fetch.ts" },
  // Run the Worker near its database and APIs rather than near each visitor.
  // Without this, every query from a page in Nairobi would cross to the
  // database region and back, which is slower than Vercel's single region.
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes fall back to index.html, as the vercel.json rewrite did.
    "not_found_handling": "single-page-application",
    // API paths must reach the Worker even when no asset matches.
    "run_worker_first": ["/api/*"]
  },
  // The server environment check (src/server/env.ts) treats the runtime as
  // production when NODE_ENV is "production".
  "vars": { "NODE_ENV": "production" },
  // Runtime secrets are set with `npx wrangler secret put NAME` or in the
  // Cloudflare dashboard; see .env.example for the full list.
  "keep_vars": true,
  "workers_dev": true,
  "routes": [{ "pattern": "learn.rauell.systems", "custom_domain": true }],
  "observability": { "enabled": true }
}
