# Environment identity: local, preview, or production
DATABASE_ENVIRONMENT=local

# Use a dedicated Neon branch for each environment.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional direct migration URL if your Neon setup separates pooled and direct connections.
DATABASE_MIGRATION_URL=postgresql://user:password@host/database?sslmode=require

# Generate at least 32 random characters. Never reuse across environments.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:5173

# Transactional email. Omit locally to use development email capture.
RESEND_API_KEY=
EMAIL_FROM=Rauell AI Academy <academy@example.com>

# Vercel Blob private storage foundation
BLOB_READ_WRITE_TOKEN=
MAX_PROJECT_UPLOAD_BYTES=10485760

# Certificate configuration
CERTIFICATE_ISSUER=Rauell AI Academy
CERTIFICATE_SIGNING_SECRET=replace-with-a-separate-long-random-secret

# Optional monitoring
SENTRY_DSN=

# One-time initial role bootstrap. Remove immediately after use.
ALLOW_SUPER_ADMIN_BOOTSTRAP=no
BOOTSTRAP_SUPER_ADMIN_USER_ID=

# NVIDIA NIM AI Gateway (Free Endpoints: build.nvidia.com)
NVIDIA_API_KEY_1=nvapi-replace-with-heavy-key-for-90b
NVIDIA_MODEL_HEAVY=meta/llama-3.2-90b-vision-instruct
NVIDIA_API_KEY_2=nvapi-replace-with-light-key-for-11b
NVIDIA_MODEL_LIGHT=meta/llama-3.2-11b-vision-instruct

