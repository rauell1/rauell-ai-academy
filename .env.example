# Environment identity: local, preview, or production
DATABASE_ENVIRONMENT=local

# Use a dedicated Neon branch for each environment.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional direct migration URL if your Neon setup separates pooled and direct connections.
DATABASE_MIGRATION_URL=postgresql://user:password@host/database?sslmode=require

# Generate at least 32 random characters. Never reuse across environments.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Absolute origin used for account links, email logos, course links, and certificate QR codes.
APP_ORIGIN=http://localhost:5173

# Transactional email. Omit locally to use development email capture.
RESEND_API_KEY=
# Use a sender mailbox verified with your email provider. A bare mailbox or Name <mailbox> is accepted; the visible sender name is always Rauell AI Academy.
EMAIL_FROM=Rauell AI Academy <academy@example.com>

# Vercel Blob private storage foundation
BLOB_READ_WRITE_TOKEN=
MAX_PROJECT_UPLOAD_BYTES=10485760

# Certificate configuration
CERTIFICATE_ISSUER=Rauell AI Academy
CERTIFICATE_SIGNING_SECRET=replace-with-a-separate-long-random-secret

# Optional monitoring
SENTRY_DSN=

# One-time initial role bootstrap. Remove immediately after use.
ALLOW_SUPER_ADMIN_BOOTSTRAP=no
BOOTSTRAP_SUPER_ADMIN_USER_ID=

# ---- AI models: the two-model rule ------------------------------------------
# Every Rauell project uses exactly two NVIDIA models and no others.
# Heavy: long writing, reasoning, documents and images. Light: chat, parsing,
# short answers. A failed or cut-off call is retried once on the other model.
# Slot 1 is live. Slot 2 is the spare, used only while slot 1 is empty, so to
# rotate a model you change or clear slot 1 on the Worker (no redeploy).
AI_MODEL_HEAVY1="nvidia/nemotron-3.5-super-vl-120b-a12b"
AI_MODEL_HEAVY2="" # spare, e.g. Mistral Large 4 (copy its id from build.nvidia.com)
AI_MODEL_LIGHT1="nvidia/nemotron-3.5-lightning-30b-a3b"
AI_MODEL_LIGHT2="google/gemma-4-31b-it" # spare
# NVIDIA keys (build.nvidia.com): _1 serves the heavy model, _2 the light one.
NVIDIA_API_KEY_1=nvapi-replace-with-heavy-key
NVIDIA_API_KEY_2=nvapi-replace-with-light-key

